{
  "name": "desktop",
  "version": "1.0.0",
  "description": "AI Browser desktop app",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:dmg": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.aibrowser.app",
    "productName": "AI Browser",
    "electronVersion": "40.2.1",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": "Apple Development: Harsh Master (3Z5VW83D4U)"
    },
    "dmg": {
      "title": "AI-Browser-1.0.0"
    },
    "files": [
      "**/*",
      "!**/node_modules/**/{CHANGELOG.md,README.md,README,readme.md}"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.2.2",
    "electron": "40.2.1",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^7.0.0-rc.9",
    "qrcode": "^1.5.4"
  }
}
